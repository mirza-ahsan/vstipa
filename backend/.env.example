# Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Service Account JSON Key Path (for Cloud Text-to-Speech)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# Optional live role-based interview generation (never expose this to Unity/WebGL)
OPENROUTER_API_KEY=your_rotated_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
